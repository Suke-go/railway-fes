{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": [
            "-hide_banner",
            "-loglevel",
            "error",
            "-y",
            "-i",
            { "validator": "\\S+" },
            "-vn",
            "-c:a",
            "libmp3lame",
            "-b:a",
            "32k",
            "-ac",
            "1",
            "-ar",
            "16000",
            { "validator": "\\S+" }
          ]
        }
      ]
    }
  ]
}
